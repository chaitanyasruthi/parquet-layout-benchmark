# Copy to .env (optional). Every value can also be passed on the make command line,
# e.g.  ROWS=1000000 make bench
# Comments are on their own lines on purpose: Make and Docker Compose treat inline
# comments differently.

# 200000000 is the full-scale target (needs tens of GB of disk and hours of runtime).
ROWS=1000000
SEED=42
# Rows per generated batch / raw file (bounds generator memory).
BATCH_ROWS=100000
RAW_DIR=data/raw
LAYOUTS_DIR=data/layouts
RESULTS_DIR=results
COLD_RUNS=5
WARM_RUNS=5
# 1 = also build the supplementary *_rg_2k layouts.
WITH_EXTRAS=1
# Memory guard for partitioned_by_user_id (rows held in memory while grouping by user).
USER_PARTITION_MAX_ROWS=5000000
LOG_LEVEL=INFO
